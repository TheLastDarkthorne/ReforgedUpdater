<Window x:Class="ReforgedUpdater.Gui.CuteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReforgedUpdater.Gui"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="22" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Effect="{DynamicResource LiftShadow}" MouseLeftButtonDown="OnDrag">
        <Grid Margin="26,24,26,22" MaxWidth="440" MinWidth="340">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:Mascot x:Name="Buddy" Width="64" Height="64" VerticalAlignment="Top" Margin="0,0,18,0" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" FontSize="13.5" LineHeight="20"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SoftButton}" Margin="0,0,10,0" MinWidth="96"
                        IsCancel="True" Click="OnCancel" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" MinWidth="96" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
