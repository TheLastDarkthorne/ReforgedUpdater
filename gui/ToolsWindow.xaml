<Window x:Class="ReforgedUpdater.Gui.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReforgedUpdater.Gui"
        Title="Tools and extras"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="680" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <DataTemplate x:Key="ToolCard">
            <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="16" Padding="16,13,16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{Binding AccentSoft}" CornerRadius="11" Padding="9,4,10,4" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding StateGlyph}" FontSize="10.5" Foreground="{Binding Accent}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Accent}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding VersionLine}" FontSize="12" Opacity="0.85" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="12.5" LineHeight="18"
                               TextWrapping="Wrap" Margin="0,7,0,0" />

                    <StackPanel Grid.Row="3" Margin="0,7,0,0">
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" FontStyle="Italic" />
                        <Border Background="{DynamicResource SkySoft}" CornerRadius="10" Padding="10,7" Margin="0,8,0,0"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
                        </Border>
                    </StackPanel>

                    <WrapPanel Grid.Row="4" Margin="0,11,0,0">
                        <Button Style="{StaticResource ChipButton}" Background="{Binding Accent}" Foreground="{DynamicResource OnAccent}"
                                Click="OnInstall" Margin="0,0,8,0" Visibility="{Binding CanInstall, Converter={StaticResource BoolVis}}"
                                AutomationProperties.Name="{Binding InstallName}">
                            <TextBlock Text="{Binding InstallText}" />
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Background="{DynamicResource Pink}" Foreground="{DynamicResource OnAccent}"
                                Click="OnRunPatcher" Margin="0,0,8,0" Visibility="{Binding CanRunPatcher, Converter={StaticResource BoolVis}}"
                                AutomationProperties.Name="Run the patcher">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="Run patcher" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Background="{DynamicResource Control}" Foreground="{DynamicResource Ink}"
                                Click="OnOpenFolder" Margin="0,0,8,0" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"
                                AutomationProperties.Name="Open the folder">
                            <TextBlock Text="Open folder" />
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Background="{DynamicResource Control}" Foreground="{DynamicResource Ink}"
                                Click="OnOpenSettings" Margin="0,0,8,0" Visibility="{Binding HasSettings, Converter={StaticResource BoolVis}}"
                                AutomationProperties.Name="Open the settings file">
                            <TextBlock Text="Open settings" />
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Background="{DynamicResource Control}" Foreground="{DynamicResource Ink}"
                                Click="OnPreset" Margin="0,0,8,0" Visibility="{Binding HasPreset, Converter={StaticResource BoolVis}}"
                                AutomationProperties.Name="Recommended settings">
                            <TextBlock Text="{Binding PresetText}" />
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Background="{DynamicResource Control}" Foreground="{DynamicResource Ink}"
                                Click="OnRepository" Margin="0,0,8,0" AutomationProperties.Name="Open its page on GitHub">
                            <TextBlock Text="GitHub page" />
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Background="Transparent" Foreground="{DynamicResource Muted}"
                                Click="OnRemove" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"
                                AutomationProperties.Name="Remove it">
                            <TextBlock Text="Remove" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="22" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Effect="{DynamicResource LiftShadow}">
        <StackPanel Margin="28,24,28,22">
            <Grid MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:Mascot x:Name="Buddy" Width="58" Height="58" Mood="Excited" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Tools and extras" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock x:Name="IntoText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,10"
                       Text="These are other people's tools. I check each download against the checksum GitHub lists, never replace a file I didn't put there, and never run anything for you." />

            <ScrollViewer x:Name="ListScroller" MaxHeight="400" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl x:Name="ToolList" ItemTemplate="{StaticResource ToolCard}" AutomationProperties.Name="Tools" />
            </ScrollViewer>

            <TextBlock x:Name="LoadingText" Style="{StaticResource Caption}" Text="Checking GitHub..." Margin="2,6,0,6" Visibility="Collapsed" />

            <Border x:Name="ErrorBox" Background="{DynamicResource BerrySoft}" CornerRadius="12" Padding="12,9" Margin="0,4,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Berry}" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Berry}" TextWrapping="Wrap" MaxWidth="560" />
                </StackPanel>
            </Border>

            <Border x:Name="ProgressBox" Background="{DynamicResource SurfaceAlt}" CornerRadius="14" Padding="14,11" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ProgressTitle" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="Bar" Style="{StaticResource CandyProgress}" Margin="0,7,0,0" IsIndeterminate="True" />
                        <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource SoftButton}" Content="Stop" VerticalAlignment="Center"
                            Margin="14,0,0,0" Click="OnStop" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" Margin="2,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="RefreshButton" Style="{StaticResource SoftButton}" Content="Check again" MinWidth="110" Margin="0,0,10,0" Click="OnRefresh" />
                <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Content="Done" MinWidth="96" IsDefault="True" IsCancel="True" Click="OnDone" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
