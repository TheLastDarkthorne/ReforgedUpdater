<Window x:Class="ReforgedUpdater.Gui.CopyPatchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReforgedUpdater.Gui"
        Title="Copy patches"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="560" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="22" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Effect="{DynamicResource LiftShadow}">
        <StackPanel Margin="28,24,28,24">
            <Grid MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:Mascot Width="58" Height="58" Mood="Excited" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Copy patches from another game" FontFamily="{StaticResource DisplayFont}" FontSize="21"
                               FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                    <TextBlock x:Name="IntoText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Copy from" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,6" />
            <ComboBox x:Name="SourcePicker" Style="{StaticResource CuteCombo}" DisplayMemberPath="Name"
                      SelectionChanged="OnSourceChanged" AutomationProperties.Name="Copy from" />
            <TextBlock x:Name="SourceHint" Style="{StaticResource Caption}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis" />

            <Border x:Name="PlanBox" Background="{DynamicResource SurfaceAlt}" CornerRadius="14" Padding="14,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="Summary" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl x:Name="CopyLines" AutomationProperties.Name="Patches to copy">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="11" Foreground="{DynamicResource Mint}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Caption}" FontSize="12.5" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel x:Name="SkipBox" Margin="0,12,0,0">
                <TextBlock Text="Left out" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Ink}" Margin="2,0,0,4" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SkipLines" AutomationProperties.Name="Patches left out">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="2,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <Border x:Name="ErrorBox" Background="{DynamicResource BerrySoft}" CornerRadius="12" Padding="12,9" Margin="0,12,0,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Berry}" Margin="0,0,10,0"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Berry}" TextWrapping="Wrap" MaxWidth="440" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="VerifyRow" Orientation="Horizontal" Margin="2,14,0,0" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="OnVerifyLabel">
                <CheckBox x:Name="VerifyBox" Style="{StaticResource PickBox}" VerticalAlignment="Center"
                          AutomationProperties.Name="Double-check each copy" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Double-check each copy" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Reads every copied file back to make sure it was written correctly. Slower." Style="{StaticResource Caption}"
                               FontSize="12" TextWrapping="Wrap" MaxWidth="440" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SoftButton}" Content="Not now" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" MinWidth="120" IsDefault="True" Click="OnCopy"
                        IsEnabled="False" AutomationProperties.Name="Copy">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,8,0" />
                        <TextBlock x:Name="CopyText" Text="Copy" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
