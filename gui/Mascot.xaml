<UserControl x:Class="ReforgedUpdater.Gui.Mascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="84" Height="84">
    <!-- Belora, the updater's little elf. Drawn on a 100x100 canvas and scaled to fit. -->
    <Viewbox>
        <Canvas Width="100" Height="100">

            <Ellipse x:Name="Shadow" Canvas.Left="22" Canvas.Top="89" Width="56" Height="8" Fill="{DynamicResource MascotShadow}"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="ShadowScale" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Canvas x:Name="Body" Width="100" Height="100" RenderTransformOrigin="0.5,0.9">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Squish" />
                        <TranslateTransform x:Name="Hop" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- back of the hair, falling past the shoulders -->
                <Path Data="M20,52 C17,30 32,16 50,16 C68,16 83,30 80,52 C82,64 82,75 78,86 L74.5,80 L71.5,88 C67.5,80 66,70 66,62 L34,62 C34,70 32.5,80 28.5,88 L25.5,80 L22,86 C18,75 18,64 20,52 Z"
                      Fill="#E8B54A" Stroke="#C98A2E" StrokeThickness="1.4" StrokeLineJoin="Round" />

                <!-- tunic, belt and collar: mint by day, crimson and gold in dark mode (see the palettes) -->
                <Path Data="M35,71 C40,69 60,69 65,71 L70,89 C60,93 40,93 30,89 Z" Stroke="{DynamicResource TunicStroke}" StrokeThickness="1.6">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="{DynamicResource TunicTop}" />
                            <GradientStop Offset="1" Color="{DynamicResource TunicBottom}" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M32.3,81 L67.7,81 L68.7,84.5 L31.3,84.5 Z" Fill="{DynamicResource Belt}" />
                <Rectangle Canvas.Left="47.5" Canvas.Top="80.2" Width="5" Height="5" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource Buckle}" Stroke="{DynamicResource BuckleStroke}" StrokeThickness="0.8" />
                <Path Data="M42,71.5 L50,77.5 L58,71.5" Stroke="{DynamicResource Collar}" StrokeThickness="1.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- long ears, swept upward the way high elves wear them -->
                <Path Data="M28,43 C22,34 12,22 7,10 C9,26 16,44 28,56 Z" Fill="#FFE0D0" Stroke="#E3A088" StrokeThickness="1.6"
                      StrokeLineJoin="Round" />
                <Path Data="M25.5,46 C20.5,38 14.5,28 10.5,18 C12,29 18,40 25.5,52 Z" Fill="#FFB6C8" />
                <Path Data="M72,43 C78,34 88,22 93,10 C91,26 84,44 72,56 Z" Fill="#FFE0D0" Stroke="#E3A088" StrokeThickness="1.6"
                      StrokeLineJoin="Round" />
                <Path Data="M74.5,46 C79.5,38 85.5,28 89.5,18 C88,29 82,40 74.5,52 Z" Fill="#FFB6C8" />

                <!-- face -->
                <Ellipse Canvas.Left="25" Canvas.Top="26" Width="50" Height="48" Stroke="#E3A088" StrokeThickness="1.6">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.4,0.35" Center="0.45,0.45" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Offset="0" Color="#FFF6F0" />
                            <GradientStop Offset="1" Color="#FFD8C6" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- blush -->
                <Ellipse Canvas.Left="29" Canvas.Top="59.5" Width="10" Height="5.5" Fill="#FF7FAE" Opacity="0.5" />
                <Ellipse Canvas.Left="61" Canvas.Top="59.5" Width="10" Height="5.5" Fill="#FF7FAE" Opacity="0.5" />

                <!-- front hair in one piece: a side-swept fringe parted on the right, flowing down past each cheek -->
                <Path Data="M26,80 C21,70 19,60 21,48 C20,32 32,18 52,18 C70,18 81,30 79,48 C80,58 79,68 74,76 C71.5,70 72,62 73,56 C73.5,48 69,39 63,34 Q60,30 57,28 Q52,38 45,43 Q45,38 43,36 Q38,43 33,49 Q33,43 31,41 C27,48 26,58 28,66 C28.5,72 28,76 26,80 Z"
                      Stroke="#C98A2E" StrokeThickness="1.6" StrokeLineJoin="Round">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FFF3C4" />
                            <GradientStop Offset="1" Color="#F4C556" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M56,24 Q49,32 43,38 M52,21.5 Q42,28 34,44 M61,23 Q66,28 70,37"
                      Stroke="#D39A3A" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.7" />
                <Path Data="M34,26.5 Q42,21 51,21.5" Stroke="White" StrokeThickness="2.6" Opacity="0.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- a little crimson-and-gold sun hairpin: belore is Thalassian for "sun" -->
                <Path Data="M68.0,23.8 L69.2,27.1 L72.4,25.6 L70.9,28.8 L74.2,30.0 L70.9,31.2 L72.4,34.4 L69.2,32.9 L68.0,36.2 L66.8,32.9 L63.6,34.4 L65.1,31.2 L61.8,30.0 L65.1,28.8 L63.6,25.6 L66.8,27.1 Z"
                      Fill="#FF6F91" Stroke="#B8345A" StrokeThickness="0.9" StrokeLineJoin="Round" />
                <Ellipse Canvas.Left="66" Canvas.Top="28" Width="4" Height="4" Fill="#FFD466" Stroke="#B8345A" StrokeThickness="0.6" />

                <!-- eyes: open -->
                <Canvas x:Name="EyesOpen">
                    <Canvas x:Name="Lids" Width="100" Height="100" RenderTransformOrigin="0.5,0.54">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="Blink" />
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="36" Canvas.Top="49" Width="7.5" Height="10" Fill="#4B3A5E" />
                        <Ellipse Canvas.Left="56.5" Canvas.Top="49" Width="7.5" Height="10" Fill="#4B3A5E" />
                        <Ellipse Canvas.Left="38" Canvas.Top="50.8" Width="3" Height="3" Fill="White" />
                        <Ellipse Canvas.Left="58.5" Canvas.Top="50.8" Width="3" Height="3" Fill="White" />
                    </Canvas>
                </Canvas>

                <!-- eyes: happy ^ ^ -->
                <Canvas x:Name="EyesHappy" Visibility="Collapsed">
                    <Path Data="M35,56 Q39.5,48.5 44,56" Stroke="#4B3A5E" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M56,56 Q60.5,48.5 65,56" Stroke="#4B3A5E" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>

                <!-- eyes: oops > < -->
                <Canvas x:Name="EyesOops" Visibility="Collapsed">
                    <Path Data="M36,50 L43,54.5 L36,59" Stroke="#4B3A5E" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Path Data="M64,50 L57,54.5 L64,59" Stroke="#4B3A5E" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>

                <!-- mouths -->
                <Path x:Name="MouthSmile" Data="M46,64 Q50,68.5 54,64" Stroke="#4B3A5E" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="MouthOpen" Data="M45.5,63 Q50,63 54.5,63 Q54,70 50,70 Q46,70 45.5,63 Z" Fill="#C0406F"
                      Stroke="#4B3A5E" StrokeThickness="1.6" StrokeLineJoin="Round" Visibility="Collapsed" />
                <Ellipse x:Name="MouthO" Canvas.Left="47" Canvas.Top="63" Width="6" Height="6.5" Fill="#C0406F"
                         Stroke="#4B3A5E" StrokeThickness="1.6" Visibility="Collapsed" />
                <Path x:Name="MouthWobble" Data="M44.5,65.5 Q47.25,62.5 50,65.5 Q52.75,68.5 55.5,65.5" Stroke="#4B3A5E" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />

                <!-- sweat drop, for oops -->
                <Path x:Name="Sweat" Data="M68,39 C68,39 64,44.5 64,47 C64,49.5 65.8,51.3 68,51.3 C70.2,51.3 72,49.5 72,47 C72,44.5 68,39 68,39 Z"
                      Fill="#BFE3FF" Stroke="#7FB8F0" StrokeThickness="1.2" Visibility="Collapsed" />
            </Canvas>

            <!-- sparkles, for happy and excited -->
            <Canvas x:Name="Sparkles" Visibility="Collapsed">
                <Path x:Name="Spark1" Data="M82,1 Q83,6 88,7 Q83,8 82,13 Q81,8 76,7 Q81,6 82,1 Z" Fill="#FFC94D"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="Spark1Scale" />
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Spark2" Data="M22,3 Q22.6,6.4 26,7 Q22.6,7.6 22,11 Q21.4,7.6 18,7 Q21.4,6.4 22,3 Z" Fill="#B79BFF"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="Spark2Scale" />
                    </Path.RenderTransform>
                </Path>
                <Path Data="M91,62 Q91.5,64.5 94,65 Q91.5,65.5 91,68 Q90.5,65.5 88,65 Q90.5,64.5 91,62 Z" Fill="#FF8CC0" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
