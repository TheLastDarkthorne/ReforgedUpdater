<Window x:Class="ReforgedUpdater.Gui.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReforgedUpdater.Gui"
        Title="Add a game"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="560" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="EditionCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                                CornerRadius="14" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                                        BorderBrush="{DynamicResource Control}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="Fill" Width="8" Height="8" Fill="{DynamicResource Pink}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Pink}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Pink}" />
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="22" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Effect="{DynamicResource LiftShadow}">
        <StackPanel Margin="28,24,28,24">
            <Grid MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:Mascot Width="58" Height="58" Mood="Excited" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Add a game" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Show me where it lives and which patches it uses." Style="{StaticResource Caption}"
                               FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Game folder" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Style="{StaticResource CuteTextBox}" TextChanged="OnFolderChanged"
                         AutomationProperties.Name="Game folder" />
                <Button Grid.Column="1" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="OnBrowse"
                        AutomationProperties.Name="Browse">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Foreground="{DynamicResource Pink}" Margin="0,0,8,0" />
                        <TextBlock Text="Browse" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="FolderHint" Style="{StaticResource Caption}" Margin="4,6,0,0" TextWrapping="Wrap"
                       Text="The folder with Wow.exe in it." />

            <TextBlock Text="Nickname" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Style="{StaticResource CuteTextBox}" TextChanged="OnNameEdited"
                     AutomationProperties.Name="Nickname" />
            <TextBlock Style="{StaticResource Caption}" Margin="4,6,0,0"
                       Text="A short name, like warmane or turtle. The command line uses it too: --game &lt;name&gt;" />

            <TextBlock Text="Patch set" Style="{StaticResource FieldLabel}" />
            <RadioButton x:Name="PickWotlk" Style="{StaticResource EditionCard}" GroupName="Edition" Tag="wotlk"
                         AutomationProperties.Name="WotLK 3.3.5a">
                <StackPanel>
                    <TextBlock Text="WotLK 3.3.5a" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Wrath of the Lich King servers" Style="{StaticResource Caption}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PickKronos" Style="{StaticResource EditionCard}" GroupName="Edition" Tag="kronos"
                         AutomationProperties.Name="Vanilla 1.12, Kronos">
                <StackPanel>
                    <TextBlock Text="Vanilla 1.12 · Kronos" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Standard 1.12 client: Kronos and other non-Turtle vanilla servers" Style="{StaticResource Caption}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PickTurtle" Style="{StaticResource EditionCard}" GroupName="Edition" Tag="turtle"
                         AutomationProperties.Name="Vanilla 1.12, Turtle WoW">
                <StackPanel>
                    <TextBlock Text="Vanilla 1.12 · Turtle WoW" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Turtle WoW's client, and servers built on it" Style="{StaticResource Caption}" />
                </StackPanel>
            </RadioButton>

            <Border x:Name="ErrorBox" Background="{DynamicResource BerrySoft}" CornerRadius="12" Padding="12,9" Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Berry}" Margin="0,0,10,0"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Berry}" TextWrapping="Wrap" MaxWidth="440" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SoftButton}" Content="Cancel" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="120" IsDefault="True" Click="OnAdd"
                        AutomationProperties.Name="Add game">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="Add game" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
