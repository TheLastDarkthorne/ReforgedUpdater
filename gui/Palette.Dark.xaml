<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark palette: deep plum, with the accents lifted so they stay readable. Defines the
        same keys as Palette.Light.xaml.
    -->

    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1D1626" />
        <GradientStop Offset="1" Color="#2A1E3A" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Ink" Color="#F2E8FF" />
    <SolidColorBrush x:Key="Muted" Color="#AD9CC4" />
    <SolidColorBrush x:Key="Line" Color="#3D3150" />

    <!-- surfaces: cards, dialogs, pop-ups, and their hover states -->
    <SolidColorBrush x:Key="Surface" Color="#2A2138" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#33283F" />
    <SolidColorBrush x:Key="Highlight" Color="#3A2D4A" />
    <SolidColorBrush x:Key="HoverBorder" Color="#9A5C85" />
    <SolidColorBrush x:Key="Control" Color="#5C4B72" />
    <SolidColorBrush x:Key="Strip" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="StripBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="LogBackground" Color="#CC231B2F" />
    <SolidColorBrush x:Key="Thumb" Color="#4A3D5E" />
    <SolidColorBrush x:Key="CaptionHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TooltipBackground" Color="#F2E8FF" />
    <SolidColorBrush x:Key="TooltipInk" Color="#2A2138" />

    <!-- accents, each with a soft tint for pills and bubbles -->
    <SolidColorBrush x:Key="Pink" Color="#FF8CC0" />
    <SolidColorBrush x:Key="PinkSoft" Color="#4A2640" />
    <SolidColorBrush x:Key="Lilac" Color="#B79CFF" />
    <SolidColorBrush x:Key="LilacSoft" Color="#362A55" />
    <SolidColorBrush x:Key="Mint" Color="#5ED6A7" />
    <SolidColorBrush x:Key="MintSoft" Color="#1E3B33" />
    <SolidColorBrush x:Key="Peach" Color="#FFA36E" />
    <SolidColorBrush x:Key="PeachSoft" Color="#45301F" />
    <SolidColorBrush x:Key="Sky" Color="#7FB3FF" />
    <SolidColorBrush x:Key="SkySoft" Color="#1F2F4B" />
    <SolidColorBrush x:Key="Butter" Color="#F2C55A" />
    <SolidColorBrush x:Key="ButterSoft" Color="#403518" />
    <SolidColorBrush x:Key="Berry" Color="#FF7C97" />
    <SolidColorBrush x:Key="BerrySoft" Color="#4A2230" />
    <!-- text on a solid accent: the accents are light here, so the text goes dark -->
    <SolidColorBrush x:Key="OnAccent" Color="#1D1626" />

    <DropShadowEffect x:Key="SoftShadow" Color="#000000" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.45" />
    <DropShadowEffect x:Key="LiftShadow" Color="#000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6" />

    <!-- Belora's evening outfit: crimson and gold -->
    <Color x:Key="TunicTop">#E5566F</Color>
    <Color x:Key="TunicBottom">#A3213F</Color>
    <SolidColorBrush x:Key="TunicStroke" Color="#6E1027" />
    <SolidColorBrush x:Key="Collar" Color="#F2C55A" />
    <SolidColorBrush x:Key="Belt" Color="#E8B84A" />
    <SolidColorBrush x:Key="Buckle" Color="#FFE9A8" />
    <SolidColorBrush x:Key="BuckleStroke" Color="#A8741C" />
    <SolidColorBrush x:Key="MascotShadow" Color="#66000000" />
</ResourceDictionary>
